{
  "version": 1,
  "description": "Synthetic gate regression cases, not detector evaluation. All observations are manually constructed; no models, applications, recorded commands, or vulnerability scans run.",
  "categories": {
    "TP": "A supported synthetic vulnerability stays in the accepted findings.",
    "FP": "A synthetic false alarm is excluded only with positive counterevidence.",
    "TN": "A benign or inapplicable scope cell receives independent review.",
    "FN": "An omitted candidate or coverage gap cannot yield a clean completed audit.",
    "guardrail": "Uncertainty, dissent, incomplete review, and stale inputs block completion.",
    "malformed": "Invalid identifiers or references are rejected."
  },
  "cases": [
    {
      "id": "backed-finding-kept",
      "category": "TP",
      "scenario": "supported",
      "description": "Four source-backed claims, claim-specific negative checks and complete independent coverage retain the candidate.",
      "expected": {
        "audit": "complete",
        "disposition": "kept"
      }
    },
    {
      "id": "evidence-backed-false-positive-excluded",
      "category": "FP",
      "scenario": "false_positive",
      "description": "A contradicted precondition and explicit source-backed exclusion remove a false alarm.",
      "expected": {
        "audit": "complete",
        "disposition": "excluded"
      }
    },
    {
      "id": "evidence-backed-inapplicable-excluded",
      "category": "FP",
      "scenario": "not_applicable",
      "description": "An inapplicable candidate still completes all passes and records an exclusion basis.",
      "expected": {
        "audit": "complete",
        "disposition": "excluded"
      }
    },
    {
      "id": "benign-empty-scope-reviewed",
      "category": "TN",
      "scenario": "supported",
      "description": "The benign list route and absent admin route are independently challenged despite producing no candidates.",
      "expected": {
        "audit": "complete",
        "disposition": "kept"
      }
    },
    {
      "id": "untracked-candidate-blocked",
      "category": "FN",
